conky.config = {
    update_interval = 2,
    double_buffer = true,
    no_buffers = true,
    text_buffer_size = 2048,

    own_window = true,
    own_window_class = 'Conky',
    own_window_type = 'dock',
    own_window_hints = 'undecorated,above,sticky,skip_taskbar,skip_pager',
    own_window_transparent = true,
    own_window_argb_visual = true,
    own_window_argb_value = 0,

    alignment = 'top_right',
    gap_x = 450,
    gap_y = 60,

    draw_shades = true,
    default_shade_color = 'black',
    draw_outline = false,
    draw_borders = false,

    use_xft = true,
    font = 'Noto Sans:size=12:bold',
    default_color = 'white',
}

conky.text = [[
CPU: ${execi 2 sensors | grep 'Tctl' | awk '{print $2}'}
GPU: ${execi 2 sensors | grep -m 1 'edge' | awk '{print $2}'}
]]
